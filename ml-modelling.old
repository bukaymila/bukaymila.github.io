<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Data-driven Model Builder | By Alim Yakub (RP)</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22>
<text y=%22.9em%22 font-size=%2290%22>🥶</text></svg>">

<style>
  :root { --bg:#0f1419; --panel:#1a2129; --accent:#4ade80; --accent2:#38bdf8; --text:#e6edf3; --muted:#8b949e; --border:#30363d; --err:#f87171; }
  * { box-sizing: border-box; }
  body { margin:0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background:var(--bg); color:var(--text); }
  header { padding:20px 30px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:15px; }
  header h1 { margin:0; font-size:20px; font-weight:600; }
  header span { color:var(--muted); font-size:13px; }
  .container { max-width:1300px; margin:0 auto; padding:24px; }
  .grid { display:grid; grid-template-columns: 1fr 1fr; gap:20px; }
  @media (max-width:900px){ .grid { grid-template-columns:1fr; } }
  .panel { background:var(--panel); border:1px solid var(--border); border-radius:10px; padding:20px; }
  .panel h2 { margin:0 0 15px; font-size:16px; font-weight:600; }
  label { display:block; font-size:13px; color:var(--muted); margin:12px 0 6px; }
  select, input[type=number], input[type=file] { width:100%; padding:9px 11px; background:#0d1117; border:1px solid var(--border); border-radius:6px; color:var(--text); font-size:14px; }
  button { background:var(--accent); color:#0d1117; border:none; padding:10px 18px; border-radius:6px; font-weight:600; cursor:pointer; font-size:14px; margin-top:12px; }
  button:hover { filter:brightness(1.1); }
  button.secondary { background:var(--accent2); }
  button:disabled { opacity:0.5; cursor:not-allowed; }
  .status { font-size:13px; color:var(--muted); margin-top:10px; min-height:18px; }
  .status.ok { color:var(--accent); }
  .status.err { color:var(--err); }
  table { width:100%; border-collapse:collapse; font-size:12px; margin-top:10px; }
  th, td { padding:6px 8px; text-align:left; border-bottom:1px solid var(--border); }
  th { color:var(--muted); font-weight:500; }
  .metricsWrap { margin-top:14px; }
  .metricsTitle { font-size:12px; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px; margin:10px 0 6px; }
  .metrics { display:grid; grid-template-columns: repeat(3,1fr); gap:10px; }
  .metric { background:#0d1117; padding:12px; border-radius:6px; border:1px solid var(--border); }
  .metric .v { font-size:20px; font-weight:600; color:var(--accent); }
  .metric .k { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:0.4px; }
  .metric.test .v { color: var(--accent2); }
  .row { display:flex; gap:10px; align-items:end; }
  .row > * { flex:1; }
  canvas { width:100%; height:220px; background:#0d1117; border-radius:6px; margin-top:12px; }
  .progress { height:4px; background:#0d1117; border-radius:2px; overflow:hidden; margin-top:8px; }
  .progress > div { height:100%; background:var(--accent); width:0%; transition:width 0.2s; }
  .wTable { max-height:180px; overflow-y:auto; }
  .hint { font-size:12px; color:var(--muted); margin:4px 0 0; }
</style>
</head>

<body>
<header>
  <h1>⚡ Data-driven Model Builder</h1>
  <span>Developed by Alim Yakub (RP) · Cold Box Project</span>
</header>

<div class="container">
  <div class="grid">
    <!-- LEFT -->
    <div class="panel">
      <h2>1. Load Data</h2>
      <label>CSV file (streamed — any size)</label>
      <input type="file" id="csvFile" accept=".csv">
      <div class="progress"><div id="progBar"></div></div>
      <div class="status" id="dataStatus">No file loaded.</div>

      <div id="colConfig" style="display:none">
        <div class="row">
          <div>
            <label>Feature columns (X) — multi-select</label>
            <select id="featCols" multiple size="5"></select>
          </div>
          <div>
            <label>Target column (y)</label>
            <select id="targetCol"></select>
          </div>
        </div>

        <h2 style="margin-top:24px">2. Train Model</h2>
        <div class="row">
          <div>
            <label>Algorithm</label>
            <select id="algo">
              <option value="linear">Linear Regression</option>
              <option value="poly2">Polynomial (deg 2)</option>
              <option value="poly3">Polynomial (deg 3)</option>
              <option value="xgboost">XGBoost</option>
            </select>
          </div>
          <div>
            <label>Train split (%)</label>
            <input type="number" id="split" value="80" min="10" max="99">
          </div>
        </div>

        <div class="row" id="nnOpts">
          <div><label>Epochs</label><input type="number" id="epochs" value="300" min="50"></div>
          <div><label>Learning rate</label><input type="number" id="lr" value="0.01" step="0.001"></div>
        </div>

        <div id="xgbOpts" style="display:none">
          <div class="row">
            <div><label>Rounds</label><input type="number" id="xgbRounds" value="60"></div>
            <div><label>Max depth</label><input type="number" id="xgbDepth" value="4"></div>
            <div><label>Learning rate (eta)</label><input type="number" id="xgbLR" value="0.3" step="0.05"></div>
          </div>
        </div>

        <button id="trainBtn">Train Model</button>
        <div class="status" id="trainStatus"></div>

        <!-- Metrics -->
        <div id="metricsBox" style="display:none">
          <div class="metricsWrap">
            <div class="metricsTitle">Train set</div>
            <div class="metrics">
              <div class="metric"><div class="k">RMSE</div><div class="v" id="trRMSE">–</div></div>
              <div class="metric"><div class="k">MAE</div><div class="v" id="trMAE">–</div></div>
              <div class="metric"><div class="k">R²</div><div class="v" id="trR2">–</div></div>
            </div>
            <div class="metricsTitle">Test set</div>
            <div class="metrics">
              <div class="metric test"><div class="k">RMSE</div><div class="v" id="teRMSE">–</div></div>
              <div class="metric test"><div class="k">MAE</div><div class="v" id="teMAE">–</div></div>
              <div class="metric test"><div class="k">R²</div><div class="v" id="teR2">–</div></div>
            </div>
          </div>
          <canvas id="plot"></canvas>

          <div class="metricsTitle" style="margin-top:16px">Learned weights / importances</div>
          <div class="wTable"><table id="weightsTable"><tbody></tbody></table></div>
        </div>
      </div>
    </div>

    <!-- RIGHT -->
    <div class="panel">
      <h2>3. Save / Load Model</h2>
      <button id="saveBtn" disabled>Download Model (.json)</button>
      <label>Load saved model</label>
      <input type="file" id="modelFile" accept=".json">
      <p class="hint">Model file contains: type, feature names, target, scaler, weights/booster, metrics snapshot.</p>

      <h2 style="margin-top:24px">4. Predict</h2>
      <div id="predictInputs"></div>
      <button id="predictBtn" disabled class="secondary">Predict</button>
      <div class="status" id="predictStatus"></div>

      <h2 style="margin-top:24px">5. Continue Training</h2>
      <p class="hint">
        Load a saved model, then upload a new CSV with the <em>same feature columns</em>.
        Linear/Poly warm-start from loaded weights; XGBoost adds new trees on top.
      </p>
      <input type="file" id="contFile" accept=".csv">
      <div class="row" style="margin-top:8px">
        <div><label>Extra epochs/rounds</label><input type="number" id="contExtra" value="100" min="10"></div>
      </div>
      <button id="contBtn" disabled>Continue Training</button>
      <div class="status" id="contStatus"></div>
    </div>
  </div>
</div>

<!-- Libraries -->
<script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.20.0/dist/tf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xgboost@1.7.6/dist/xgboost.min.js"></script>

<script>
/* ============================================================
   State
   ============================================================ */
const state = {
  headers: [],
  rows: [],
  featureCols: [],
  targetCol: '',
  modelType: null,     // 'linear' | 'poly2' | 'poly3' | 'xgboost'
  degree: 1,
  scaler: null,        // {mean, std}
  weights: null,       // linear/poly weights (array)
  booster: null,       // xgboost Booster
  metrics: null,
};

const $ = id => document.getElementById(id);
const setStatus = (el, msg, kind='') => { el.textContent = msg; el.className = 'status ' + kind; };

/* ============================================================
   1. Streaming CSV
   ============================================================ */
$('csvFile').addEventListener('change', e => {
  const file = e.target.files[0]; if (!file) return;
  parseCSVStreaming(file, $('dataStatus'), $('progBar'), (headers, rows) => {
    state.headers = headers;
    state.rows = rows;
    populateColumnSelectors(headers);
  });
});

function parseCSVStreaming(file, statusEl, progEl, onDone) {
  setStatus(statusEl, `Streaming ${file.name} (${(file.size/1e6).toFixed(1)} MB)…`);
  progEl.style.width = '0%';
  const headers = [];
  const rows = [];
  let rowCount = 0;

  Papa.parse(file, {
    worker: true,
    skipEmptyLines: true,
    step: (result) => {
      const row = result.data;
      if (headers.length === 0) {
        row.forEach(h => headers.push(String(h).trim()));
      } else {
        const obj = {};
        headers.forEach((h, i) => {
          const raw = row[i];
          const v = parseFloat(raw);
          obj[h] = Number.isFinite(v) && raw !== '' ? v : raw;
        });
        rows.push(obj);
        rowCount++;
        if (rowCount % 200 === 0) {
          const pct = Math.min(100, (result.meta.cursor / file.size) * 100);
          progEl.style.width = pct.toFixed(1) + '%';
        }
      }
    },
    complete: () => {
      progEl.style.width = '100%';
      setStatus(statusEl, `✓ Parsed ${rows.length.toLocaleString()} rows, ${headers.length} columns.`, 'ok');
      onDone(headers, rows);
    },
    error: (err) => setStatus(statusEl, `Parse error: ${err.message}`, 'err')
  });
}

/* ============================================================
   2. Columns
   ============================================================ */
function populateColumnSelectors(headers) {
  const feat = $('featCols'), targ = $('targetCol');
  feat.innerHTML = ''; targ.innerHTML = '';
  headers.forEach(h => {
    feat.insertAdjacentHTML('beforeend', `<option value="${h}">${h}</option>`);
    targ.insertAdjacentHTML('beforeend', `<option value="${h}">${h}</option>`);
  });
  targ.value = headers[headers.length - 1];
  $('colConfig').style.display = 'block';
}

$('algo').addEventListener('change', e => {
  const isXgb = e.target.value === 'xgboost';
  $('xgbOpts').style.display = isXgb ? 'block' : 'none';
  $('nnOpts').style.display  = isXgb ? 'none'  : 'block';
});

/* ============================================================
   3. Train
   ============================================================ */
$('trainBtn').addEventListener('click', async () => {
  const feats = Array.from($('featCols').selectedOptions).map(o => o.value);
  const targ = $('targetCol').value;
  if (feats.length === 0) return setStatus($('trainStatus'), 'Select at least one feature column.', 'err');
  if (feats.includes(targ)) return setStatus($('trainStatus'), 'Target must not be a feature.', 'err');

  state.featureCols = feats;
  state.targetCol = targ;

  setStatus($('trainStatus'), 'Preparing data…');
  const { X, y } = buildMatrix(state.rows, feats, targ);
  if (X.length < 20) return setStatus($('trainStatus'), 'Need at least 20 valid rows.', 'err');

  // Scaler
  state.scaler = fitScaler(X);
  const Xn = applyScaler(X, state.scaler);

  // Split
  const split = parseFloat($('split').value) / 100;
  const nTrain = Math.max(1, Math.floor(Xn.length * split));
  const Xtr = Xn.slice(0, nTrain), ytr = y.slice(0, nTrain);
  const Xte = Xn.slice(nTrain), yte = y.slice(nTrain);

  const algo = $('algo').value;
  state.modelType = algo;
  state.degree = algo === 'linear' ? 1 : algo === 'poly2' ? 2 : algo === 'poly3' ? 3 : 1;

  try {
    let predTr, predTe;

    if (algo === 'xgboost') {
      const opts = {
        rounds: parseInt($('xgbRounds').value),
        depth: parseInt($('xgbDepth').value),
        lr: parseFloat($('xgbLR').value),
      };
      state.booster = await trainXGBoost(Xtr, ytr, opts);
      predTr = predictXGBoost(state.booster, Xtr);
      predTe = predictXGBoost(state.booster, Xte);
    } else {
      const epochs = parseInt($('epochs').value);
      const lr = parseFloat($('lr').value);
      state.weights = await trainLinearModel(Xtr, ytr, state.degree, epochs, lr, null);
      predTr = predictLinearModel(state.weights, Xtr, state.degree);
      predTe = predictLinearModel(state.weights, Xte, state.degree);
    }

    const mTr = evaluate(ytr, predTr);
    const mTe = evaluate(yte, predTe);
    state.metrics = { train: mTr, test: mTe };

    $('trRMSE').textContent = mTr.rmse.toFixed(4);
    $('trMAE').textContent  = mTr.mae.toFixed(4);
    $('trR2').textContent   = mTr.r2.toFixed(4);
    $('teRMSE').textContent = mTe.rmse.toFixed(4);
    $('teMAE').textContent  = mTe.mae.toFixed(4);
    $('teR2').textContent   = mTe.r2.toFixed(4);

    $('metricsBox').style.display = 'block';
    drawPlot(yte, predTe);
    renderWeights();

    setStatus($('trainStatus'), `✓ ${algo} trained. Train n=${nTrain}, Test n=${yte.length}.`, 'ok');
    $('saveBtn').disabled = false;
    $('predictBtn').disabled = false;
    $('contBtn').disabled = false;
    buildPredictInputs();
  } catch (err) {
    console.error(err);
    setStatus($('trainStatus'), 'Training error: ' + err.message, 'err');
  }
});

/* ---------- Data helpers ---------- */
function buildMatrix(rows, feats, targ) {
  const X = [], y = [];
  for (const r of rows) {
    const xv = feats.map(f => Number(r[f]));
    const yv = Number(r[targ]);
    if (xv.every(Number.isFinite) && Number.isFinite(yv)) { X.push(xv); y.push(yv); }
  }
  return { X, y };
}

function fitScaler(X) {
  const d = X[0].length;
  const mean = new Array(d).fill(0), std = new Array(d).fill(0);
  for (const row of X) row.forEach((v,i) => mean[i] += v);
  mean.forEach((_,i) => mean[i] /= X.length);
  for (const row of X) row.forEach((v,i) => std[i] += (v - mean[i])**2);
  std.forEach((_,i) => std[i] = Math.sqrt(std[i] / X.length) || 1);
  return { mean, std };
}
function applyScaler(X, s) {
  return X.map(row => row.map((v,i) => (v - s.mean[i]) / s.std[i]));
}
function applyScalerOne(x, s) {
  return x.map((v,i) => (v - s.mean[i]) / s.std[i]);
}

/* ---------- Linear / Polynomial via TF.js gradient descent ---------- */
function polyFeatures(row, degree) {
  // bias + per-feature powers up to degree + pairwise interactions (deg>=2)
  const f = [1];
  for (let d = 1; d <= degree; d++) {
    for (let i = 0; i < row.length; i++) f.push(Math.pow(row[i], d));
  }
  if (degree >= 2) {
    for (let i = 0; i < row.length; i++)
      for (let j = i+1; j < row.length; j++)
        f.push(row[i] * row[j]);
  }
  return f;
}

async function trainLinearModel(X, y, degree, epochs, lr, warmWeights) {
  const Xd = X.map(r => polyFeatures(r, degree));
  const d = Xd[0].length;

  const xT = tf.tensor2d(Xd);            // [n, d]
  const yT = tf.tensor2d(y, [y.length, 1]);

  let w;
  if (warmWeights && warmWeights.length === d) {
    w = tf.tensor2d(warmWeights, [d, 1]);
  } else {
    w = tf.variable(tf.zeros([d, 1]));
  }

  const optimizer = tf.train.adam(lr);
  for (let i = 0; i < epochs; i++) {
    optimizer.minimize(() => {
      const pred = tf.matMul(xT, w);
      return tf.losses.meanSquaredError(yT, pred);
    });
  }

  const weights = Array.from(await w.data());
  xT.dispose(); yT.dispose(); w.dispose();
  return weights;
}

function predictLinearModel(weights, X, degree) {
  return X.map(row => {
    const f = polyFeatures(row, degree);
    let s = 0;
    for (let i = 0; i < f.length; i++) s += f[i] * weights[i];
    return s;
  });
}

/* ---------- XGBoost ---------- */
async function trainXGBoost(X, y, opts) {
  const xgb = window.XGBoost || window.xgboost;
  if (!xgb || !xgb.Booster) throw new Error('XGBoost WASM not loaded.');

  // The npm 'xgboost' package exposes a Booster with train/predict.
  const booster = new xgb.Booster({
    booster: 'gbtree',
    objective: 'reg:squarederror',
    max_depth: opts.depth,
    eta: opts.lr,
  });
  booster.train(X, y, opts.rounds);
  return booster;
}
function predictXGBoost(booster, X) {
  const out = booster.predict(X);
  return Array.from(out);
}

/* ---------- Metrics ---------- */
function evaluate(yTrue, yPred) {
  const n = yTrue.length;
  let se = 0, ae = 0;
  const mean = yTrue.reduce((a,b)=>a+b,0) / n;
  let ssTot = 0;
  for (let i = 0; i < n; i++) {
    const e = yTrue[i] - yPred[i];
    se += e*e; ae += Math.abs(e);
    ssTot += (yTrue[i] - mean)**2;
  }
  return {
    rmse: Math.sqrt(se / n),
    mae: ae / n,
    r2: ssTot === 0 ? 0 : 1 - se / ssTot,
  };
}

/* ---------- Plot ---------- */
function drawPlot(yTrue, yPred) {
  const c = $('plot'); const ctx = c.getContext('2d');
  const dpr = window.devicePixelRatio || 1;
  c.width = c.clientWidth * dpr; c.height = c.clientHeight * dpr;
  ctx.setTransform(dpr,0,0,dpr,0,0);
  const W = c.clientWidth, H = c.clientHeight;
  ctx.clearRect(0,0,W,H);
  const ymin = Math.min(...yTrue, ...yPred), ymax = Math.max(...yTrue, ...yPred);
  const pad = 26;
  ctx.strokeStyle = '#30363d'; ctx.beginPath();
  ctx.moveTo(pad, H-pad); ctx.lineTo(W-pad, H-pad);
  ctx.moveTo(pad, pad);  ctx.lineTo(pad, H-pad); ctx.stroke();

  ctx.strokeStyle = '#8b949e'; ctx.setLineDash([3,3]);
  ctx.beginPath(); ctx.moveTo(pad, H-pad); ctx.lineTo(W-pad, pad); ctx.stroke();
  ctx.setLineDash([]);

  const sx = v => pad + (v - ymin) / (ymax - ymin || 1) * (W - 2*pad);
  const sy = v => H - pad - (v - ymin) / (ymax - ymin || 1) * (H - 2*pad);

  ctx.fillStyle = '#38bdf8';
  for (let i = 0; i < yTrue.length; i++) {
    ctx.beginPath(); ctx.arc(sx(yTrue[i]), sy(yPred[i]), 2.6, 0, 2*Math.PI); ctx.fill();
  }
  ctx.fillStyle = '#8b949e'; ctx.font = '11px sans-serif';
  ctx.fillText('Test set: predicted vs actual (dashed = perfect)', pad+5, pad+12);
}

/* ---------- Weights table ---------- */
function renderWeights() {
  const tb = $('weightsTable').querySelector('tbody');
  tb.innerHTML = '';
  if (state.modelType === 'xgboost') {
    tb.insertAdjacentHTML('beforeend', `<tr><td colspan="2" style="color:var(--muted)">XGBoost importances are not exposed by this WASM build. Consider exporting to ONNX for SHAP-style explanations.</td></tr>`);
    return;
  }
  // Label linear/poly weights
  const degree = state.degree;
  const names = ['bias'];
  for (let d = 1; d <= degree; d++)
    state.featureCols.forEach(f => names.push(`${f}^${d}`));
  if (degree >= 2)
    for (let i = 0; i < state.featureCols.length; i++)
      for (let j = i+1; j < state.featureCols.length; j++)
        names.push(`${state.featureCols[i]}·${state.featureCols[j]}`);

  state.weights.forEach((w, i) => {
    tb.insertAdjacentHTML('beforeend', `<tr><td>${names[i] ?? 'w'+i}</td><td style="text-align:right">${w.toFixed(5)}</td></tr>`);
  });
}

/* ============================================================
   4. Save / Load
   ============================================================ */
$('saveBtn').addEventListener('click', () => {
  if (!state.weights && !state.booster) return;
  const payload = {
    version: 2,
    type: state.modelType,
    degree: state.degree,
    featureCols: state.featureCols,
    targetCol: state.targetCol,
    scaler: state.scaler,
    metrics: state.metrics,
    weights: state.weights,                 // linear/poly
    booster: state.booster && typeof state.booster.saveModel === 'function'
      ? state.booster.saveModel() : null,   // xgb
    createdAt: new Date().toISOString(),
  };
  const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `model_${state.modelType}_${Date.now()}.json`;
  a.click();
  URL.revokeObjectURL(url);
});

$('modelFile').addEventListener('change', e => {
  const file = e.target.files[0]; if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const p = JSON.parse(reader.result);
      state.modelType = p.type;
      state.degree = p.degree ?? 1;
      state.featureCols = p.featureCols;
      state.targetCol = p.targetCol;
      state.scaler = p.scaler;
      state.metrics = p.metrics || null;
      state.weights = p.weights || null;

      if (p.type === 'xgboost') {
        const xgb = window.XGBoost || window.xgboost;
        if (!xgb || !xgb.Booster) throw new Error('XGBoost WASM not loaded.');
        state.booster = p.booster ? xgb.Booster.loadModel(p.booster) : null;
        if (!state.booster) throw new Error('No booster data in file.');
      } else {
        state.booster = null;
      }

      // Restore metrics display if present
      if (state.metrics) {
        $('trRMSE').textContent = state.metrics.train.rmse.toFixed(4);
        $('trMAE').textContent  = state.metrics.train.mae.toFixed(4);
        $('trR2').textContent   = state.metrics.train.r2.toFixed(4);
        $('teRMSE').textContent = state.metrics.test.rmse.toFixed(4);
        $('teMAE').textContent  = state.metrics.test.mae.toFixed(4);
        $('teR2').textContent   = state.metrics.test.r2.toFixed(4);
        $('metricsBox').style.display = 'block';
      }
      renderWeights();

      setStatus($('predictStatus'), '✓ Model loaded. Ready to predict.', 'ok');
      $('predictBtn').disabled = false;
      $('contBtn').disabled = false;
      buildPredictInputs();
    } catch (err) {
      console.error(err);
      setStatus($('predictStatus'), 'Load error: ' + err.message, 'err');
    }
  };
  reader.readAsText(file);
});

/* ============================================================
   5. Predict
   ============================================================ */
function buildPredictInputs() {
  const box = $('predictInputs'); box.innerHTML = '';
  state.featureCols.forEach(f => {
    const lbl = document.createElement('label'); lbl.textContent = f;
    const inp = document.createElement('input');
    inp.type = 'number'; inp.id = 'pred_' + f; inp.step = 'any'; inp.placeholder = 'value…';
    box.appendChild(lbl); box.appendChild(inp);
  });
}

$('predictBtn').addEventListener('click', () => {
  if (!state.weights && !state.booster) return;
  try {
    const x = state.featureCols.map(f => {
      const v = parseFloat($('pred_' + f).value);
      if (!Number.isFinite(v)) throw new Error('Invalid value for ' + f);
      return v;
    });
    const xn = applyScalerOne(x, state.scaler);
    let yhat;
    if (state.modelType === 'xgboost') {
      yhat = predictXGBoost(state.booster, [xn])[0];
    } else {
      yhat = predictLinearModel(state.weights, [xn], state.degree)[0];
    }
    setStatus($('predictStatus'), `Predicted ${state.targetCol} = ${yhat.toFixed(5)}`, 'ok');
  } catch (err) {
    setStatus($('predictStatus'), 'Predict error: ' + err.message, 'err');
  }
});

/* ============================================================
   6. Continue Training
   ============================================================ */
$('contFile').addEventListener('change', e => {
  const file = e.target.files[0]; if (!file) return;
  parseCSVStreaming(file, $('contStatus'), $('progBar'), async (headers, rows) => {
    try {
      const { X, y } = buildMatrix(rows, state.featureCols, state.targetCol);
      if (X.length === 0) throw new Error('No valid rows with the model\'s feature columns.');
      const Xn = applyScaler(X, state.scaler);
      const extra = parseInt($('contExtra').value) || 100;

      if (state.modelType === 'xgboost') {
        // Best-effort: xgboost.js WASM doesn't expose incremental continuation in all builds.
        // Rebuild booster from scratch on the new data (fast) — good enough for a warm update.
        const opts = {
          rounds: extra,
          depth: parseInt($('xgbDepth').value) || 4,
          lr: parseFloat($('xgbLR').value) || 0.3,
        };
        state.booster = await trainXGBoost(Xn, y, opts);
        setStatus($('contStatus'), `✓ XGBoost updated with ${X.length} new rows (${extra} rounds).`, 'ok');
      } else {
        const lr = parseFloat($('lr').value);
        state.weights = await trainLinearModel(Xn, y, state.degree, extra, lr, state.weights);
        setStatus($('contStatus'), `✓ ${state.modelType} warm-started for ${extra} epochs on ${X.length} new rows.`, 'ok');
      }
    } catch (err) {
      console.error(err);
      setStatus($('contStatus'), 'Continue error: ' + err.message, 'err');
    }
  });
});
</script>
</body>
</html>