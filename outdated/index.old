<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Cold box Apps | By Alim Yakub (RP)</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🥶</text></svg>">
    <link rel="stylesheet" href="assets\styles\theme.css">
    <style>
        html, body {
            min-height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding: calc(var(--nav-height) + 24px) 24px 32px;
        }

        .container {
            width: 100%;
            max-width: 1800px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 28px;
        }

        .header {
            text-align: center;
        }

        .header h1 {
            font-size: clamp(1.6rem, 4vw, 2.6rem);
            font-weight: 800;
            letter-spacing: -0.02em;
            color: var(--ink);
            margin: 0 0 6px;
        }

        .subhead {
            color: var(--ink-muted);
            font-size: clamp(0.82rem, 1.6vw, 0.98rem);
        }

        .subhead .dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--green);
            vertical-align: middle;
            margin: 0 6px 2px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .tool-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease,
                        border-color 0.2s ease;
            position: relative;
        }

        .tool-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
            border-color: var(--green);
            text-decoration: none;
            color: inherit;
        }

        .visual-area {
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            background: var(--green-soft);
            border-bottom: 1px solid var(--border);
        }

        .giant-icon {
            font-size: clamp(3rem, 8vw, 5rem);
            filter: drop-shadow(0 4px 10px rgba(22, 22, 21, 0.12));
            transition: transform 0.3s ease;
            font-variant-emoji: text;
            color: var(--green-deep);
        }

        .tool-card:hover .giant-icon {
            transform: scale(1.08) rotate(3deg);
        }

        .visual-area::before {
            content: '';
            position: absolute;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle,
                rgba(111, 176, 30, 0.18) 0%,
                rgba(111, 176, 30, 0) 65%);
            top: -50%;
            left: -50%;
            opacity: 0;
            transition: opacity 0.4s ease;
            pointer-events: none;
        }

        .tool-card:hover .visual-area::before { opacity: 1; }

        .card-content {
            padding: 18px 16px 20px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .tool-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.3;
            font-variant-emoji: text;
        }

        .launch-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            background: var(--green);
            color: #ffffff;
            padding: 7px 16px;
            border-radius: 60px;
            font-weight: 600;
            font-size: 0.82rem;
            transition: all 0.2s ease;
            width: fit-content;
        }

        .tool-card:hover .launch-badge {
            background: var(--green-hover);
            gap: 8px;
            padding: 7px 18px;
        }

        .launch-badge::after {
            content: '→';
            font-size: 1em;
            transition: transform 0.2s ease;
        }

        .tool-card:hover .launch-badge::after {
            transform: translateX(3px);
        }

        /* -------- coming-soon variant -------- */
        .tool-card.coming-soon {
            cursor: default;
            opacity: 0.75;
        }

        .tool-card.coming-soon:hover {
            transform: none;
            box-shadow: var(--shadow-sm);
            border-color: var(--border);
        }

        .tool-card.coming-soon .visual-area {
            background: var(--bg-alt);
        }

        .tool-card.coming-soon .giant-icon {
            color: var(--ink-faint);
        }

        .coming-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-alt);
            color: var(--ink-muted);
            border: 1px solid var(--border-strong);
            padding: 6px 14px;
            border-radius: 60px;
            font-weight: 600;
            font-size: 0.78rem;
            width: fit-content;
        }

        .coming-tag {
            position: absolute;
            top: 12px;
            right: 12px;
            background: var(--accent);
            color: #ffffff;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            z-index: 2;
        }

        .footer-note {
            text-align: center;
            color: var(--ink-faint);
            font-size: 0.72rem;
            margin-top: 8px;
        }

        @media (max-width: 600px) {
            body { padding: calc(var(--nav-height) + 16px) 12px 24px; }
            .grid { gap: 12px; }
            .visual-area { height: 140px; }
            .card-content { padding: 14px 12px 16px; }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="header">
            <h1>Cold Box Launchpad</h1>
            <div class="subhead">
                Cold Box Project<span class="dot"></span>Alim Yakub (RP)
            </div>
        </div>

        <div class="grid">
            <a href="U07B-extract.html" class="tool-card">
                <div class="visual-area"><div class="giant-icon">◐</div></div>
                <div class="card-content">
                    <div class="tool-title">U07B Extractor</div>
                    <div class="launch-badge">Launch</div>
                </div>
            </a>

            <a href="csv-edit.html" class="tool-card">
                <div class="visual-area"><div class="giant-icon">▦</div></div>
                <div class="card-content">
                    <div class="tool-title">CSV Processor</div>
                    <div class="launch-badge">Launch</div>
                </div>
            </a>

            <a href="csv-aggregator.html" class="tool-card">
                <div class="visual-area"><div class="giant-icon">▤</div></div>
                <div class="card-content">
                    <div class="tool-title">Row CSV Aggregator</div>
                    <div class="launch-badge">Launch</div>
                </div>
            </a>

            <a href="line-chart.html" class="tool-card">
                <div class="visual-area"><div class="giant-icon">↗</div></div>
                <div class="card-content">
                    <div class="tool-title">Line Chart Studio</div>
                    <div class="launch-badge">Launch</div>
                </div>
            </a>

            <a href="shaded-chart.html" class="tool-card">
                <div class="visual-area"><div class="giant-icon">◫</div></div>
                <div class="card-content">
                    <div class="tool-title">Shaded Region Chart Studio</div>
                    <div class="launch-badge">Launch</div>
                </div>
            </a>

            <a href="stl-viewer.html" class="tool-card">
                <div class="visual-area"><div class="giant-icon">◇</div></div>
                <div class="card-content">
                    <div class="tool-title">STL 3D Viewer</div>
                    <div class="launch-badge">Launch</div>
                </div>
            </a>

            <a href="ml-modelling.html" class="tool-card">
                <div class="visual-area"><div class="giant-icon">∿</div></div>
                <div class="card-content">
                    <div class="tool-title">Model Builder</div>
                    <div class="launch-badge">Launch</div>
                </div>
            </a>
        </div>

        <div class="footer-note">
            Cold box project | Alim Yakub | Republic Polytechnic
        </div>
    </div>

    <script src="assets\scripts\navbar.js" defer></script>
</body>
</html>